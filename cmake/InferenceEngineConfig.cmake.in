@PACKAGE_INIT@

# InferenceEngine package. Consumers need, on their own side:
#   - nlohmann_json and pcre2 (e.g. from vcpkg)
#   - the CUDA toolkit, for packages built with CUDA (cudart + cuBLAS are linked)

include(CMakeFindDependencyMacro)

set(InferenceEngine_CUDA @IE_ENABLE_CUDA@)

find_dependency(nlohmann_json CONFIG)
find_dependency(pcre2 CONFIG)
if(InferenceEngine_CUDA)
    find_dependency(CUDAToolkit)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/InferenceEngineTargets.cmake")

check_required_components(InferenceEngine)
